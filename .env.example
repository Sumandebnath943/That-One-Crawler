# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables instead (then redeploy).
# Both are optional: the crawler works without them.

# AI fixes ("✦ Get AI fixes" in the page drawer). Set either key (or both).
# Groq: free key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: any Groq chat model that supports JSON mode.
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: any Gemini model ID, e.g. gemini-3.8-flash for smarter (slower) answers.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: with both keys set Groq is used; set this to "gemini" to prefer Gemini.
# AI_PROVIDER=gemini

# PageSpeed Insights scores. Free key: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_KEY=

# Optional: set if you add a custom domain, so social preview images use it.
# NEXT_PUBLIC_SITE_URL=https://thatonecrawler.example

# Dev only: allow crawling localhost / private IPs (blocked by default).
# ALLOW_PRIVATE_URLS=1
