# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables instead (then redeploy).
# All are optional: the crawler works without them.

# AI tools (the "✦ AI tools" tab in the page drawer). Set either key (or both).
# Groq: free key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: a Groq chat model with JSON mode. Leave unset to use openai/gpt-oss-120b
# (with openai/gpt-oss-20b as backup). An override is tried first, then the defaults.
# GROQ_MODEL=openai/gpt-oss-120b

# Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: any Gemini model ID, e.g. gemini-3.8-flash for smarter (slower) answers.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: short jobs try Groq first and long ones Gemini first. Force one with:
# AI_PROVIDER=gemini

# Optional: free AI actions per visitor per day (default 20). After that, visitors can
# paste their own free Gemini key, which stays in their browser.
# AI_DAILY_LIMIT=20
# Optional: secret for signing the quota cookie (derived from the AI keys if unset).
# AI_QUOTA_SECRET=

# PageSpeed Insights scores. Free key: https://developers.google.com/speed/docs/insights/v5/get-started
# The same key powers real-user speed (CrUX) if you also enable the "Chrome UX Report API"
# for its Google Cloud project.
PAGESPEED_KEY=

# Optional: set if you add a custom domain, so canonical URLs, the sitemap and social
# preview images use it.
# NEXT_PUBLIC_SITE_URL=https://thatonecrawler.example

# Dev only: allow crawling localhost / private IPs (blocked by default). Never on Vercel.
# ALLOW_PRIVATE_URLS=1

# Visitor alerts on Telegram (the beacon), plus crawler/bot alerts and the contact form.
# With the token or chat id unset, all of it is a quiet no-op. Setup: docs/BEACON.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any long random string (letters, digits, _ or -). Lets the bot take commands like /bots off.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Optional: bot alerts before you've used /bots: 1 = all (default), ai = AI agents only, 0 = humans only.
# BEACON_ALERT_BOTS=1
# Dev only: let localhost visits and requests alert too (curl is a recognised bot).
# NEXT_PUBLIC_BEACON_DEBUG=1

# Search engine ownership verification (public tokens, not secrets). Paste only the content="…"
# value from each provider's meta tag; each tag is left out when unset. See docs/INDEXING_GUIDE.md
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# YANDEX_VERIFICATION=

# Optional: override the Google Analytics 4 ID built into src/lib/site.ts (G-7VVFQHW4RV), or "off". Honors the same
# opt-out as the visitor alerts, and the Privacy page mentions it only when it's on.
# NEXT_PUBLIC_GA_ID=
